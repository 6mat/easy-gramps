# Copy to .env and fill in.

# How this app reaches Gramps Web. Laptop: the public URL. Server: the internal Docker URL.
GRAMPS_URL=https://gramps.example.com
# The Gramps Web address users' browsers should open (menu link). Defaults to GRAMPS_URL.
# On the same site as this app (https://gramps.example.com with the app at /family) the login is shared.
GRAMPS_PUBLIC_URL=
GRAMPS_LINK_LABEL=Full Gramps
# Menu "Source code" link. Leave empty for the upstream repository; set it to your own copy if you change the code.
SOURCE_URL=
# The app is served under this path, next to Gramps Web on the same domain.
BASE_PATH=/family
# A tag to put on records the tree makes, so they can be found in Gramps Web (e.g. Easy Gramps). Empty: no tag.
TREE_TAG=
# 1 = accept screen-measurement reports from ?debug (written to data/debug.log). Leave empty normally.
DEBUG_LOG=
# Laptop port (development compose only).
PORT=8095

# deploy/compose.traefik.yaml only
GRAMPS_HOST=gramps.example.com
CERT_RESOLVER=letsencrypt
